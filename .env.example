# Root commands
# Copy app-specific env files from:
# - apps/api/.env.example -> apps/api/.env
# - apps/web/.env.example -> apps/web/.env.local

# Local API database
DATABASE_URL="postgresql://bbs_user:bbs_password@localhost:5432/blooming_beauty"

# Must match apps/api/.env and apps/web/.env.local when running locally
JWT_SECRET="change-this-in-development-and-production"

# Public site origin
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Blooming Beauty Skin"

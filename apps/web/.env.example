# API
# Leave unset to use same-origin /api through Next rewrites.
# For separate local API access, use: http://localhost:4000/api
NEXT_PUBLIC_API_URL=""

# Server-to-server API rewrite target used by next.config.js
API_INTERNAL_URL="http://localhost:4000/api"

# Site Info
NEXT_PUBLIC_SITE_NAME="Blooming Beauty Skin"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Must match apps/api/.env exactly so middleware can verify auth cookies.
JWT_SECRET="change-this-in-development-and-production"

# Cloudinary unsigned upload config for admin image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
